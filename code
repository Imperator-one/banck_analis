import tkinter as tk
from tkinter import messagebox


# 1. АВТОМАТИЧЕСКАЯ ГЕНЕРАЦИЯ БАЗЫ (250 ЧЕЛОВЕК)

DB_USERS = {}
DB_CREDITS = {}

# Заготовки для создания случайных ФИО
surnames = ["Иванов", "Петров", "Сидоров", "Кузнецов", "Смирнов", "Попов", "Васильев", "Соколов", "Новиков", "Морозов"]
names = ["Иван", "Алексей", "Сергей", "Дмитрий", "Андрей", "Михаил", "Федор", "Егор", "Артем", "Николай"]
patronymics = ["Иванович", "Петрович", "Сергеевич", "Васильевич", "Александрович", "Дмитриевич", "Николаевич", "Владимирович"]

# Цикл создает 250 записей с ID от 101 до 350
for i in range(250):
    uid = str(101 + i)
    
    # Собираем ФИО по кругу из списков заготовок
    fio = f"{surnames[i % 10]} {names[(i + 3) % 10]} {patronymics[(i + 5) % 8]}"
    DB_USERS[uid] = fio

    # Распределяем финансовые ситуации по разным алгоритмам
    if i % 4 == 0:
        DB_CREDITS[uid] = {
            "status": "Одобрен", "reason": "Идеальная кредитная история, задержек нет",
            "total_credits": 1200000, "delayed_payments": 0, "active_credits": 1
        }
    elif i % 5 == 1:
        DB_CREDITS[uid] = {
            "status": "Одобрен", "reason": "Новый клиент, кредитная история отсутствует",
            "total_credits": 0, "delayed_payments": 0, "active_credits": 0
        }
    elif i % 3 == 0:
        DB_CREDITS[uid] = {
            "status": "Отказан", "reason": "Множественные задержки выплат, высокая долговая нагрузка",
            "total_credits": 3500000, "delayed_payments": 45, "active_credits": 4
        }
    elif i % 2 == 0:
        DB_CREDITS[uid] = {
            "status": "Одобрен", "reason": "Были незначительные задержки, сейчас долгов нет",
            "total_credits": 450000, "delayed_payments": 2, "active_credits": 0
        }
    else:
        DB_CREDITS[uid] = {
            "status": "Отказан", "reason": "Превышен лимит по количеству одновременных кредитов",
            "total_credits": 5000000, "delayed_payments": 12, "active_credits": 6
        }



# 2. ЛОГИКА ИНТЕРФЕЙСА

def check_user(event=None):
    user_id = entry_id.get().strip()
    
    # Очистка полей перед выводом нового результата
    label_user_info.config(text="")
    label_status.config(text="")
    label_details.config(text="")
    label_stats.config(text="")
    
    if not user_id:
        messagebox.showwarning("Ошибка", "Введите ID пользователя!")
        return

    if user_id in DB_USERS:
        user_name = DB_USERS[user_id]
        label_user_info.config(text=f"Пользователь: {user_name}", fg="black")
        
        credit_data = DB_CREDITS.get(user_id)
        
        if credit_data:
            status = credit_data["status"]
            details = credit_data["reason"]
            total_credits = credit_data["total_credits"]
            delayed_payments = credit_data["delayed_payments"]
            active_credits = credit_data["active_credits"]
            
            if status == "Одобрен":
                label_status.config(text="СТАТУС: ОДОБРЕН", fg="green")
            elif status == "Отказан":
                label_status.config(text="СТАТУС: ОТКАЗАН", fg="red")
            else:
                label_status.config(text="СТАТУС: НЕИЗВЕСТЕН", fg="orange")
                
            label_details.config(text=f"Решение: {details}")
            
            # Красивый вывод числовых данных
            stats_text = (
                f"Общая сумма кредитов: {total_credits:,} руб.\n"
                f"Задержки выплат (дней/раз): {delayed_payments}\n"
                f"Активные кредиты сейчас: {active_credits}"
            )
            label_stats.config(text=stats_text)
        else:
            label_status.config(text="СТАТУС: ДАННЫЕ ОТСУТСТВУЮТ", fg="orange")
            label_stats.config(text="Общая сумма кредитов: 0 руб.\nЗадержки выплат: 0\nАктивные кредиты: 0")
    else:
        label_user_info.config(text="Пользователь не найден в базе данных!", fg="red")



# 3. СОЗДАНИЕ ГРАФИЧЕСКОГО ОКНА

root = tk.Tk()
root.title("Банковская система проверки")
root.geometry("500x450")
root.resizable(False, False)

font_main = ("Arial", 11)
font_bold = ("Arial", 11, "bold")
font_stats = ("Courier New", 10, "bold")

lbl_id = tk.Label(root, text="Введите ID клиента (от 101 до 350):", font=font_main)
lbl_id.pack(pady=10)

entry_id = tk.Entry(root, font=font_main, width=20, justify="center")
entry_id.pack(pady=5)
entry_id.focus()
entry_id.bind("<Return>", check_user)

btn_check = tk.Button(root, text="Проверить", font=font_bold, bg="#4CAF50", fg="white", width=15, command=check_user)
btn_check.pack(pady=10)

separator = tk.Frame(root, height=2, bd=1, relief="sunken")
separator.pack(fill="x", padx=10, pady=10)

label_user_info = tk.Label(root, text="", font=font_bold, wraplength=450)
label_user_info.pack(pady=5)

label_status = tk.Label(root, text="", font=("Arial", 13, "bold"))
label_status.pack(pady=5)

label_details = tk.Label(root, text="", font=font_main, wraplength=450)
label_details.pack(pady=5)

label_stats = tk.Label(root, text="", font=font_stats, justify="left", bg="#f0f0f0", padx=10, pady=10, bd=1, relief="groove")
label_stats.pack(pady=10, fill="x", padx=20)

root.mainloop()
